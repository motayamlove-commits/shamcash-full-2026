# ═══════════════════════════════════════════════════════════
# FIREBASE CONFIGURATION (shamnew-3ff53)
# ═══════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=shamnew-3ff53.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shamnew-3ff53
VITE_FIREBASE_STORAGE_BUCKET=shamnew-3ff53.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Realtime Database URL
VITE_FIREBASE_DATABASE_URL=https://shamnew-3ff53-default-rtdb.europe-west1.firebasedatabase.app

# Web Push Certificate Key
VITE_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY

# ═══════════════════════════════════════════════════════════
# SOCKET.IO SERVER
# ═══════════════════════════════════════════════════════════

VITE_SOCKET_URL=http://localhost:3001

# ═══════════════════════════════════════════════════════════
# SERVER-SIDE (for Socket.io server)
# ═══════════════════════════════════════════════════════════

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Service Account (JSON string - get from Firebase Console)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
