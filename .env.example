# ─────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────
# Get these values from your Supabase project settings
# Settings > API > Project URL and Project API keys (anon public)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────
# Firebase Cloud Messaging Configuration
# ─────────────────────────────────────────────
# Get these values from Firebase Console
# Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef

# Web Push VAPID Key (get from Firebase Console > Messaging > Web configuration)
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key

# ─────────────────────────────────────────────
# Firebase Service Account (Backend only - NEVER expose to frontend!)
# ─────────────────────────────────────────────
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# IMPORTANT: Paste the JSON as a single line, replacing newlines with \n
# Example format:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
FIREBASE_SERVICE_ACCOUNT=

# ─────────────────────────────────────────────
# Application Settings (Optional)
# ─────────────────────────────────────────────
# VITE_APP_TITLE=Newsham Registration Portal

# ─────────────────────────────────────────────
# Socket.io Server URL
# ─────────────────────────────────────────────
# Deploy the server from /server directory on Railway
# Get the URL after deployment
VITE_SOCKET_URL=https://your-socket-server.railway.app
